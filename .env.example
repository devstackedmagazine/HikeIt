# ─────────────────────────────────────────────────────────────────────────────
# HikeIt — environment variables
#
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* vars are exposed to the browser. Everything else is server-only.
# All of these are validated at build time in src/config/env.ts — a missing or
# malformed value will fail the build rather than blow up at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical, fully-qualified URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# DATABASE_URL  → pooled connection (PgBouncer, port 6543) used by the running app.
# DIRECT_URL    → direct connection (port 5432) used by drizzle-kit migrations.
# Find both under Supabase → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth — from Meta for Developers. Optional; social sign-in just
# omits the Facebook button's provider until these are set.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── Paddle ───────────────────────────────────────────────────────────────────
# Use SANDBOX values locally and in Vercel Preview; LIVE values in Production
# only. The two accounts are separate — keys, price ids and webhook secrets all
# differ between them.
#
# PADDLE_ENV drives the server SDK and NEXT_PUBLIC_PADDLE_ENV drives Paddle.js
# in the browser. Both are needed: a server-only variable cannot reach the
# client. Neither is inferred from the key prefix, on purpose.
PADDLE_ENV="sandbox"                        # sandbox | production
PADDLE_API_KEY="pdl_sdbx_apikey_..."
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
NEXT_PUBLIC_PADDLE_ENV="sandbox"            # sandbox | production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."

# ── Mapbox ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_MAPBOX_TOKEN removed — maps now use Leaflet + OpenStreetMap (no token needed)

# ── Cloudflare R2 (S3-compatible object storage) ─────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="hikeit"
# Public base URL for the bucket (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_URL="https://cdn.hikeit.app"

# ── OpenWeatherMap ───────────────────────────────────────────────────────────

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY="re_..."
# Verified sender address, e.g. "HikeIt <noreply@hikeit.app>"
EMAIL_FROM="HikeIt <noreply@hikeit.app>"

# ── Sentry (error monitoring) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Server-only token used to upload source maps during build.
SENTRY_AUTH_TOKEN=""

# ── PostHog (product analytics) ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

CRON_SECRET=""

# Paddle price ids (pri_...). Create the four prices in each Paddle account.
PADDLE_PRICE_PRO_MONTHLY=""
PADDLE_PRICE_PRO_YEARLY=""
PADDLE_PRICE_TEAM_MONTHLY=""
PADDLE_PRICE_TEAM_YEARLY=""

CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
